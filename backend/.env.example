APP_NAME="Clinic SaaS Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Central Database (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=clinic_central
DB_USERNAME=clinic_user
DB_PASSWORD=secret

# Tenant DB
TENANCY_DB_HOST=postgres
TENANCY_DB_PORT=5432
TENANCY_DB_USERNAME=clinic_user
TENANCY_DB_PASSWORD=secret

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@clinicplatform.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 / MinIO
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=clinic-storage
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Twilio (SMS)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# WhatsApp Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# JWT
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Pusher / Broadcasting
BROADCAST_DRIVER=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Platform Domain
CENTRAL_DOMAIN=localhost
TENANT_SUBDOMAIN_WILDCARD=*.localhost

# Horizon
HORIZON_DOMAIN=localhost
HORIZON_PATH=horizon

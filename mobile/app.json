{
  "expo": {
    "name": "ClinicPro",
    "slug": "clinic-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clinicpro.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for telemedicine video calls",
        "NSMicrophoneUsageDescription": "Used for telemedicine audio calls",
        "NSPhotoLibraryUsageDescription": "Upload medical documents"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563eb"
      },
      "package": "com.clinicpro.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2563eb",
          "defaultChannel": "appointments"
        }
      ],
      [
        "expo-camera",
        { "cameraPermission": "Allow ClinicPro to access your camera for video calls." }
      ]
    ],
    "scheme": "clinicpro",
    "extra": {
      "eas": { "projectId": "your-eas-project-id" },
      "apiUrl": "https://api.clinicplatform.com"
    }
  }
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  status             String   @default("TRIALING") // ACTIVE, TRIALING, SUSPENDED, ARCHIVED
  websiteName        String?
  supportEmail       String?
  supportPhone       String?
  timezone           String   @default("UTC")
  locale             String   @default("en")
  subscriptionPlan   String?  @default("FREE")
  subscriptionStatus String?  @default("inactive")
  trialEndsAt        DateTime?
  metadata           String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clinics        Clinic[]
  users          User[]
  patients       Patient[]
  appointments   Appointment[]
  passwordResets PasswordResetToken[]
  auditLogs      AuditLog[]
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  hashedPassword  String
  name            String
  role            String   @default("STAFF") // SUPER_ADMIN, TENANT_ADMIN, DOCTOR, STAFF, PATIENT
  tenantId        String?
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  clinicId        String?
  clinic          Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  patientId       String?  @unique
  patient         Patient? @relation("PatientPortalUser", fields: [patientId], references: [id], onDelete: SetNull)
  phone           String?
  avatarUrl       String?
  title           String?
  isActive        Boolean  @default(true)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  doctorAppointments Appointment[]       @relation("DoctorAppointments")
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]

  @@index([tenantId])
  @@index([clinicId])
  @@index([role])
}

model Clinic {
  id               String   @id @default(cuid())
  name             String
  slug             String
  city             String
  addressLine1     String?
  addressLine2     String?
  manager          String
  phone            String?
  email            String?
  rooms            Int      @default(0)
  timezone         String   @default("UTC")
  status           String   @default("OPERATIONAL") // OPERATIONAL, LAUNCHING, UNDER_REVIEW, INACTIVE
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isBookingEnabled Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users        User[]
  appointments Appointment[]
  patients     Patient[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([status])
}

model Patient {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId         String
  clinic           Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  portalUser       User?    @relation("PatientPortalUser")
  name             String
  email            String?
  phone            String?
  mrn              String   @unique
  status           String   @default("STABLE") // STABLE, URGENT, PENDING, NEEDS_FOLLOW_UP, INACTIVE
  dateOfBirth      DateTime?
  gender           String?
  emergencyContact String?
  emergencyPhone   String?
  notes            String?
  team             String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lastVisit        DateTime?

  appointments Appointment[]

  @@index([tenantId])
  @@index([clinicId])
  @@index([status])
}

model Appointment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      User     @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Restrict)
  startsAt    DateTime
  endsAt      DateTime?
  status      String   @default("PENDING") // CONFIRMED, PENDING, CANCELLED, COMPLETED, NO_SHOW
  source      String   @default("STAFF") // STAFF, PATIENT_PORTAL, API
  reason      String?
  notes       String?
  cancelledAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([clinicId])
  @@index([patientId])
  @@index([doctorId])
  @@index([startsAt])
  @@index([status])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // LOGIN_SUCCESS, LOGIN_FAILED, PASSWORD_RESET_REQUESTED, PASSWORD_RESET_COMPLETED, USER_CREATED, USER_UPDATED, TENANT_CREATED, TENANT_UPDATED, CLINIC_CREATED, CLINIC_UPDATED, APPOINTMENT_CREATED, APPOINTMENT_UPDATED, APPOINTMENT_CANCELLED
  entityType String
  entityId   String?
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  clinicId   String?
  ipAddress  String?
  userAgent  String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([tenantId])
  @@index([clinicId])
  @@index([createdAt])
}
